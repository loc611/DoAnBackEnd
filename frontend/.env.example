# ========================================================
# Frontend Environment Variables Template
# ========================================================

# URL Backend API kết nối tới máy chủ Express/NodeJS
# Lưu ý: Luôn kèm đường dẫn /api ở cuối

# Chạy Local:
VITE_API_URL=http://localhost:5000/api

# Triển khai Production (Vercel / Render / Railway):
# Cấu hình giá trị này trực tiếp trên Dashboard của Vercel (Settings -> Environment Variables)
# VITE_API_URL=https://your-backend-service.onrender.com/api
