generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["admin", "teacher", "student", "public"]
}

// ==========================================
// 👑 SCHEMA: admin
// ==========================================
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      String   // 'admin', 'teacher', 'student'
  status    String   @default("active") // 'active', 'inactive'
  
  // Relations
  admin         Admin?
  teacher       Teacher?
  student       Student?
  notifications Notification[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("admin")
}

model Admin {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String
  phone    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("admin")
}

model FeeProfile {
  id           String     @id @default(uuid())
  name         String
  amount       Float
  targetGrades Int[]      // Array of grades, e.g., [10, 11, 12]
  academicYear String     // e.g., "2026-2027"
  semester     String     // e.g., "HK1" or "All"
  
  feeBills     FeeBill[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@schema("admin")
}

model FeeBill {
  id           String     @id @default(uuid())
  feeProfileId String
  feeProfile   FeeProfile @relation(fields: [feeProfileId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  status       String     @default("unpaid") // 'unpaid', 'paid'
  dueDate      DateTime?
  paidAt       DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([feeProfileId, studentId])
  @@schema("admin")
}

// ==========================================
// 🧑‍🏫 SCHEMA: teacher
// ==========================================
model Teacher {
  id             String @id @default(uuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherCode    String @unique
  fullName       String
  phone          String?
  specialization String?

  // Relations
  homeroomClasses Class[]
  subjects        Subject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("teacher")
}

model Class {
  id                String @id @default(uuid())
  className         String @unique
  grade             Int
  homeroomTeacherId String?
  homeroomTeacher   Teacher? @relation(fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  academicYear      String

  // Relations
  students      Student[]
  schedules     Schedule[]
  grades        Grade[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("active")

  @@schema("teacher")
}

model Subject {
  id          String @id @default(uuid())
  subjectCode String @unique
  name        String
  credits     Int
  type        String @default("Bắt buộc") // 'Bắt buộc', 'Tự chọn'
  teacherId   String?
  teacher     Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("teacher")
}

// ==========================================
// 🎓 SCHEMA: student
// ==========================================
model Student {
  id          String @id @default(uuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentCode String @unique
  fullName    String
  dateOfBirth DateTime?
  gender      String?
  address     String?
  phone       String?
  parentName  String?
  parentPhone String?
  
  classId     String?
  class       Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  grades      Grade[]
  feeBills    FeeBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("student")
}

model Grade {
  id        String @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  semester  String @default("HK1_2026")
  
  math      Float @default(0)
  literature Float @default(0)
  english   Float @default(0)
  physics   Float @default(0)
  chemistry Float @default(0)
  it        Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, classId, semester])
  @@schema("student")
}

model Schedule {
  id        String @id @default(uuid())
  classId   String
  class     Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  semester  String @default("HK1_2026")
  period    String
  
  monday    String @default("-")
  tuesday   String @default("-")
  wednesday String @default("-")
  thursday  String @default("-")
  friday    String @default("-")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, semester, period])
  @@schema("student")
}

model Notification {
  id          String @id @default(uuid())
  title       String
  content     String
  type        String @default("Thông báo chung")
  
  targetClassId String?
  targetClass   Class? @relation(fields: [targetClassId], references: [id], onDelete: SetNull)
  
  createdById   String
  createdBy     User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("student")
}

