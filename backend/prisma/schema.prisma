generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 🛡️ ENUMS
// ==========================================
enum Role {
  ADMIN
  TEACHER
  STUDENT
}

// ==========================================
// 1️⃣ USER / AUTHENTICATION MODEL
// ==========================================
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      String   // Hoặc dùng enum Role nếu muốn
  status    String   @default("active") // 'active', 'inactive', 'blocked'
  
  // Relations
  admin         Admin?
  teacher       Teacher?
  student       Student?
  notifications Notification[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

// ==========================================
// 👑 ADMIN PROFILE
// ==========================================
model Admin {
  id       String  @id @default(uuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String
  phone    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 🧑‍🏫 TEACHER PROFILE
// ==========================================
model Teacher {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherCode    String    @unique
  fullName       String
  phone          String?
  specialization String?

  // Relations
  homeroomClasses Class[]   @relation("HomeroomTeacher")
  subjects        Subject[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([teacherCode])
}

// ==========================================
// 🏫 CLASS & SUBJECT
// ==========================================
model Class {
  id                String    @id @default(uuid())
  className         String    @unique
  grade             Int
  homeroomTeacherId String?
  homeroomTeacher   Teacher?  @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  academicYear      String
  status            String    @default("active")

  // Relations
  students      Student[]
  schedules     Schedule[]
  grades        Grade[]
  attendances   Attendance[]
  examSchedules ExamSchedule[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id             String   @id @default(uuid())
  subjectCode    String   @unique
  name           String
  grade          Int      @default(0) // 0: Toàn trường / Tất cả khối, 10: Khối 10, 11: Khối 11, 12: Khối 12
  periodsPerWeek Int      @default(2) // Số tiết học / tuần
  credits        Int      @default(2) // Giữ trường tương thích nếu cần
  type           String   @default("Bắt buộc") // 'Bắt buộc', 'Tự chọn'
  teacherId      String?
  teacher        Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  subjectEnrollments SubjectEnrollment[]
  attendances        Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 📚 SUBJECT ENROLLMENT (Học sinh học môn tự chọn/chuyên đề)
// ==========================================
model SubjectEnrollment {
  id           String   @id @default(uuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear String   @default("2026-2027")
  semester     String   @default("HK1_2026")
  createdAt    DateTime @default(now())

  @@unique([studentId, subjectId, semester])
  @@index([studentId])
  @@index([subjectId])
}

// ==========================================
// 🎓 STUDENT PROFILE
// ==========================================
model Student {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentCode String    @unique
  fullName    String
  dateOfBirth DateTime?
  gender      String?
  address     String?
  phone       String?
  parentName  String?
  parentPhone String?
  
  classId     String?
  class       Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)

  grades             Grade[]
  attendances        Attendance[]
  subjectEnrollments SubjectEnrollment[]
  feeBills           FeeBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentCode])
  @@index([classId])
}

// ==========================================
// 📅 SCHEDULE (Lịch học)
// ==========================================
model Schedule {
  id        String @id @default(uuid())
  classId   String
  class     Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  semester  String @default("HK1_2026")
  period    String
  
  monday    String @default("-")
  tuesday   String @default("-")
  wednesday String @default("-")
  thursday  String @default("-")
  friday    String @default("-")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, semester, period])
  @@index([classId, semester])
}

// ==========================================
// 📊 ATTENDANCE, EXAM & GRADES
// ==========================================
model Attendance {
  id           String   @id @default(uuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  date         DateTime
  session      String   @default("morning") // 'morning', 'afternoon'
  periodNumber Int      @default(1)         // Tiết 1..10
  periodName   String   @default("Tiết 1")  // Tên hiển thị e.g. "Tiết 1 (07:00 - 07:45)"
  subjectId    String?
  subject      Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectName  String   @default("")
  status       String   @default("present") // 'present', 'late', 'excused', 'unexcused'
  note         String?
  markedById   String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, classId, date, periodNumber])
  @@index([classId, date, periodNumber])
  @@index([studentId, date])
}

model ExamSchedule {
  id           String    @id @default(uuid())
  examName     String    // e.g. "Thi Giữa Học Kỳ 1"
  examType     String    @default("Giữa kỳ") // 'Giữa kỳ', 'Cuối kỳ', 'Khảo sát'
  subjectName  String
  grade        Int       // 10, 11, 12 hoặc 0 (Tất cả)
  classId      String?
  class        Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  examDate     DateTime
  startTime    String    // e.g. "07:30"
  duration     Int       // minutes, e.g. 45, 60, 90
  room         String    // e.g. "Phòng 101 - A1"
  examFormat   String    @default("Trắc nghiệm") // 'Trắc nghiệm', 'Tự luận', 'Trắc nghiệm + Tự luận'
  semester     String    @default("HK1_2026")
  academicYear String    @default("2026-2027")
  notes        String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Grade {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  semester  String  @default("HK1_2026")
  
  math      Float   @default(0)
  literature Float  @default(0)
  english   Float   @default(0)
  physics   Float   @default(0)
  chemistry Float   @default(0)
  it        Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, classId, semester])
}

// ==========================================
// 💰 HỌC PHÍ & THÔNG BÁO
// ==========================================
model FeeProfile {
  id             String     @id @default(uuid())
  name           String
  amount         Float
  targetGrades   Int[]      // Array of grades, e.g., [10, 11, 12]
  targetClassIds String[]   @default([]) // Array of class UUIDs, e.g., ["uuid1", "uuid2"]
  academicYear   String     // e.g., "2026-2027"
  semester       String     // e.g., "HK1" or "All"
  
  feeBills       FeeBill[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model FeeBill {
  id           String     @id @default(uuid())
  feeProfileId String
  feeProfile   FeeProfile @relation(fields: [feeProfileId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  status       String     @default("unpaid") // 'unpaid', 'paid'
  dueDate      DateTime?
  paidAt       DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([feeProfileId, studentId])
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  content     String
  type        String   @default("Thông báo chung")
  
  targetClassId String?
  targetClass   Class?   @relation(fields: [targetClassId], references: [id], onDelete: SetNull)
  
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// ⚙️ SYSTEM SETTINGS (Cài đặt hệ thống)
// ==========================================
model SystemSetting {
  id                    String   @id @default("default_setting")
  schoolName            String   @default("Trường THPT TTLN")
  schoolCode            String   @default("THPT-TTLN")
  address               String   @default("123 Đường Giáo Dục, TP. Hồ Chí Minh")
  phone                 String   @default("028.3899.9999")
  email                 String   @default("contact@thpt-ttln.edu.vn")
  website               String   @default("https://thpt-ttln.edu.vn")
  principalName         String   @default("ThS. Nguyễn Văn Quản")
  logoUrl               String   @default("")
  slogan                String   @default("Ươm mầm tri thức - Vững bước tương lai")
  
  academicYear          String   @default("2026-2027")
  currentSemester       String   @default("HK1_2026")
  semesterStartDate     DateTime?
  semesterEndDate       DateTime?
  
  isGradingLocked       Boolean  @default(false)
  gradingDeadline       DateTime?
  minPassingScore       Float    @default(5.0)
  gradeScaleType        String   @default("10") // thang điểm 10
  
  maintenanceMode       Boolean  @default(false)
  sessionTimeoutMinutes Int      @default(60)
  allowRegistration     Boolean  @default(false)
  
  extraConfigs          Json?    // Cấu hình mở rộng dạng JSON
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

