generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("student") // 'admin', 'teacher', 'student'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// In a real app, you would add relations like StudentProfile, TeacherProfile, Classes, Grades etc.
// For now, focusing on the User model for authentication.
